# Local development only. Never expose AUTH_MODE=disabled to a LAN interface.
APP_ENV=development
AUTH_MODE=disabled
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_PUBLIC_URL=https://mcp.home.arpa/mcp
MCP_ALLOWED_HOSTS=127.0.0.1:3000,localhost:3000,mcp.home.arpa,mcp.home.arpa:443
MCP_ALLOWED_ORIGINS=
KEYCLOAK_ISSUER_URL=https://auth.home.arpa/realms/linux-agent
MCP_INTROSPECTION_URL=http://127.0.0.1:8080/realms/linux-agent/protocol/openid-connect/token/introspect
MCP_RESOURCE_URI=https://mcp.home.arpa/mcp
MCP_INTROSPECTION_CLIENT_ID=linux-mcp-resource-server
MCP_INTROSPECTION_CLIENT_SECRET=CHANGE_ME
MCP_REQUIRED_SCOPE=mcp.read
MCP_LOGS_SCOPE=mcp.logs.read
MCP_REQUIRED_AUDIENCE=https://mcp.home.arpa/mcp
ALLOWED_DISK_PATHS=/,/home
LOG_SOURCES_FILE=config/log-sources.example.json
JOURNALCTL_PATH=/usr/bin/journalctl
JOURNALCTL_TIMEOUT_SECONDS=1.5
MAX_LOG_OUTPUT_BYTES=65536
LOG_LEVEL=INFO
