APP_ENV=production
AUTH_MODE=keycloak
MCP_HOST=127.0.0.1
MCP_PORT=3002
MCP_PUBLIC_URL=https://mcp.home.arpa/mcp
MCP_ALLOWED_HOSTS=mcp.home.arpa,mcp.home.arpa:443
MCP_ALLOWED_ORIGINS=
KEYCLOAK_ISSUER_URL=https://auth.home.arpa/realms/linux-agent
MCP_INTROSPECTION_URL=http://127.0.0.1:8080/realms/linux-agent/protocol/openid-connect/token/introspect
MCP_RESOURCE_URI=https://mcp.home.arpa/mcp
MCP_REQUIRED_AUDIENCE=https://mcp.home.arpa/mcp
MCP_INTROSPECTION_CLIENT_ID=linux-mcp-resource-server
MCP_INTROSPECTION_CLIENT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
MCP_REQUIRED_SCOPE=mcp.read
MCP_LOGS_SCOPE=mcp.logs.read
ALLOWED_DISK_PATHS=/,/home
LOG_SOURCES_FILE=/etc/linux-mcp-agent/log-sources.json
JOURNALCTL_PATH=/usr/bin/journalctl
JOURNALCTL_TIMEOUT_SECONDS=1.5
MAX_LOG_OUTPUT_BYTES=65536
LOG_LEVEL=INFO
MCP_INTROSPECTION_CACHE_TTL_SECONDS=30.0

# Read-only diagnostics. Limit inspectable services to units approved by the administrator.
ALLOWED_SYSTEMD_UNITS=ssh.service,cron.service,systemd-timesyncd.service
SYSTEMCTL_PATH=/usr/bin/systemctl
CPU_WARNING_THRESHOLD_PERCENT=85
MEMORY_WARNING_THRESHOLD_PERCENT=90
DISK_WARNING_THRESHOLD_PERCENT=85

# Optional AI assistant. Disable by default; monitoring uses MCP directly.
AGENT_ENABLED=false
AGENT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONTEXT_LENGTH=4096
# For OpenAI instead, use AGENT_PROVIDER=openai and set OPENAI_API_KEY in this protected file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=1024
