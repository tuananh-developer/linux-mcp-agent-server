# Copy to .env and replace every CHANGE_ME value before starting the stack.
MCP_DOMAIN=mcp.home.arpa
AUTH_DOMAIN=auth.home.arpa
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_PASSWORD
