{$MCP_DOMAIN} {
    tls internal
    encode zstd gzip

    @mcp path /mcp /.well-known/oauth-protected-resource/mcp
    reverse_proxy @mcp 127.0.0.1:3000

    respond 404
}

{$AUTH_DOMAIN} {
    tls internal
    encode zstd gzip

    # Only OIDC discovery, token issuance and signing-key discovery are public to the LAN.
    @oidc path /realms/linux-agent/.well-known/openid-configuration /realms/linux-agent/protocol/openid-connect/token /realms/linux-agent/protocol/openid-connect/certs
    reverse_proxy @oidc 127.0.0.1:8080

    # Keycloak administration remains available only from the server itself.
    @loopback remote_ip 127.0.0.1 ::1
    reverse_proxy @loopback 127.0.0.1:8080

    respond 404
}
