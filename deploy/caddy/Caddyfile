{$MCP_DOMAIN} {
    tls internal
    encode zstd gzip

    @mcp path /mcp /.well-known/oauth-protected-resource/mcp
    handle @mcp {
        reverse_proxy 127.0.0.1:3002
    }

    @dashboard path / /dashboard /dashboard/assets/app.js /dashboard/assets/app.css /dashboard/assets/mcp-client.mjs /dashboard/assets/agent-ui.js /dashboard/assets/agent-client.mjs
    handle @dashboard {
        reverse_proxy 127.0.0.1:3002
    }

    @agent path /agent/status /agent/chat
    handle @agent {
        reverse_proxy 127.0.0.1:3002
    }

    handle {
        respond 404
    }
}

{$AUTH_DOMAIN} {
    tls internal
    encode zstd gzip

    @oidc path /realms/linux-agent/.well-known/openid-configuration /realms/linux-agent/protocol/openid-connect/token /realms/linux-agent/protocol/openid-connect/certs
    handle @oidc {
        reverse_proxy 127.0.0.1:8080
    }

    @loopback remote_ip 127.0.0.1 ::1
    handle @loopback {
        reverse_proxy 127.0.0.1:8080
    }

    handle {
        respond 404
    }
}
