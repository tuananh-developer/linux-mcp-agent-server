{$MCP_DOMAIN} {
    tls internal
    encode zstd gzip

    @backend path /healthz /mcp /.well-known/oauth-protected-resource/mcp / /dashboard /assistant /dashboard/assets/* /agent/status /agent/credentials /agent/credentials/* /agent/chat /agent/test
    handle @backend {
        reverse_proxy {$MCP_UPSTREAM}
    }

    handle {
        respond 404
    }
}

{$AUTH_DOMAIN} {
    tls internal
    encode zstd gzip

    @oidc path /realms/linux-agent/.well-known/openid-configuration /realms/linux-agent/protocol/openid-connect/auth /realms/linux-agent/protocol/openid-connect/token /realms/linux-agent/protocol/openid-connect/certs /realms/linux-agent/login-actions/* /resources/*
    handle @oidc {
        reverse_proxy 127.0.0.1:8080
    }

    @loopback remote_ip 127.0.0.1 ::1
    handle @loopback {
        reverse_proxy 127.0.0.1:8080
    }

    handle {
        respond 404
    }
}
