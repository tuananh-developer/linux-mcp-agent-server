{
  "realm": "linux-agent",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "mcp.read",
      "description": "Base read-only access to the Linux MCP Agent Server",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp.logs.read",
      "description": "Read allowlisted systemd journal aliases via read_allowed_log",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "linux-mcp-resource-server",
      "name": "Linux MCP Resource Server (Introspection)",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "CHANGE_ME_RESOURCE_SERVER_SECRET",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "resource_url": "https://mcp.home.arpa/mcp"
      },
      "defaultClientScopes": [
        "mcp.read"
      ],
      "optionalClientScopes": [
        "mcp.logs.read"
      ]
    },
    {
      "clientId": "linux-mcp-agent-client",
      "name": "External AI Agent MCP Client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "CHANGE_ME_AGENT_CLIENT_SECRET",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "mcp.read"
      ],
      "optionalClientScopes": [
        "mcp.logs.read"
      ],
      "protocolMappers": [
        {
          "name": "mcp-resource-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://mcp.home.arpa/mcp",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
